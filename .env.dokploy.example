# Dokploy > Docker Compose servisi > Environment bölümüne kopyalayın.
# Yerelde dolduracaksanız .env.dokploy adıyla kopyalayın; bu dosya Git'te yok sayılır.
# Zorunlu parolaları boş bırakınca Compose dağıtımı durdurur.
SITE_URL=https://veykivo.com
POSTGRES_PASSWORD=
ADMIN_EMAIL=admin@veykivo.com
ADMIN_PASSWORD=

# İsteğe bağlı: paneli salt okunur gezen demo hesabı. İkisi de doluysa ilk açılışta oluşturulur.
DEMO_EMAIL=
DEMO_PASSWORD=

# Örnek içerikleri ilk açılışta oluşturur. Boş içerikle başlamak için false yapın.
SEED_SAMPLE_CONTENT=true

# Dokploy ağının gerçek alt ağına göre güncelleyin.
FORWARD_NETWORK_CIDR=172.16.0.0/12

# İsteğe bağlı: boşsa yapay zekâ özellikleri kullanılamaz.
OPENROUTER_API_KEY=

# İsteğe bağlı: SMTP_HOST boşsa bildirim e-postaları gönderilmez.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@veykivo.com
