# Kopyalayıp .env olarak kaydedin.
DB_CONNECTION=Host=postgres;Port=5432;Database=veykivo;Username=USER;Password=PASSWORD
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=en-az-10-karakterlik-guclu-parola
# İsteğe bağlı salt okunur demo hesabı; ikisi de doluysa ilk açılışta oluşturulur.
DEMO_EMAIL=
DEMO_PASSWORD=

# Aşağıdakiler yalnız docker-compose.prod.yml için; boş bırakılırsa özellik kapalı kalır.
SITE_URL=https://veykivo.com
# API'yi proxy'leyen Docker ağının alt ağı (docker network inspect <ag> | grep Subnet).
FORWARD_NETWORKS=172.16.0.0/12
# Yapay zekâ (boşsa /api/v1/admin/ai/* 503 döner).
OPENROUTER_API_KEY=
# Talep bildirimleri (boşsa e-posta gönderilmez).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@veykivo.com
